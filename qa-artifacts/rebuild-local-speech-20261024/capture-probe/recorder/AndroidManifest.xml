<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.xmilo_at_your_side.sign_to_speak.qa.capture">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36"/>
  <queries>
    <package android:name="com.xmilo_at_your_side.sign_to_speak.qa"/>
    <package android:name="com.xmilo_at_your_side.sign_to_speak.qa.tone"/>
  </queries>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
  <application android:label="Playback Capture QA" android:testOnly="true" android:allowBackup="false" android:usesCleartextTraffic="false">
    <activity android:name=".RecorderActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".RecorderService" android:exported="false" android:foregroundServiceType="mediaProjection"/>
    <receiver android:name=".PhaseReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="com.xmilo_at_your_side.sign_to_speak.qa.capture.PHASE"/></intent-filter>
    </receiver>
  </application>
</manifest>
